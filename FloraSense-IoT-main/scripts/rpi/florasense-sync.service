[Unit]
Description=FloraSense IoT - Sincronizador de Datos Raspberry Pi hacia AWS EC2 PostgreSQL
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=iot
WorkingDirectory=/home/iot/FloraSense-IoT-main/FloraSense-IoT-main/scripts/rpi
ExecStart=/usr/bin/python3 /home/iot/FloraSense-IoT-main/FloraSense-IoT-main/scripts/rpi/florasense_sync_to_aws.py
Restart=always
RestartSec=10

# Variables de entorno (sin comillas para evitar errores de sintaxis en systemd)
Environment=SYNC_INTERVAL_SECONDS=300
Environment=AWS_DB_HOST=54.166.220.66
Environment=AWS_DB_PORT=5432
Environment=AWS_DB_NAME=smart_irrigation
Environment=AWS_DB_USER=postgres
Environment=AWS_DB_PASS=FloraSenseSecure2026!
Environment=LOCAL_DB_HOST=localhost
Environment=LOCAL_DB_PORT=5432
Environment=LOCAL_DB_NAME=smart_irrigation
Environment=LOCAL_DB_USER=postgres
Environment=LOCAL_DB_PASS=postgres

[Install]
WantedBy=multi-user.target
